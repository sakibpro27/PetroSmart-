# Copy this file to .env and fill in real values.
# Never commit .env to Git.

# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# True only on your own computer. Must be False on a live server.
DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave empty to use the local SQLite file (db.sqlite3).
# PostgreSQL example:
#   DATABASE_URL=postgres://petrosmart:password@localhost:5432/petrosmart
DATABASE_URL=

# URL path of the platform (SaaS provider) admin site.
PETROSMART_ADMIN_PATH=platform-admin/

# Production-only security switches (leave as-is for local development).
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_COOKIES=False
DJANGO_HSTS_SECONDS=0
# Only after HTTPS works on every subdomain; preload is hard to undo.
DJANGO_HSTS_PRELOAD=False
DJANGO_BEHIND_PROXY=False
DJANGO_LOG_LEVEL=WARNING

# Email for password reset. Empty backend = emails print in the terminal.
DJANGO_EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=PetroSmart <no-reply@localhost>
